    skos:prefLabel "N/A_BY_CONVENIENCE" ;
    a4:disposition "PROHIBITED" ;
    a4:identifier "N/A_BY_CONVENIENCE" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FNARROW a a4:VocabularyTerm ;
    rdfs:comment "Reduce allowed choices or topology/interaction options for a bounded risk/context reason." ;
    skos:prefLabel "NARROW" ;
    a4:disposition "PERMITTED" ;
    a4:identifier "NARROW" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FREDEFINE_CANONICAL_STRUCTURE a a4:VocabularyTerm ;
    rdfs:comment "Silently rename/redefine P1-P5, X1-X9, ABBs or M12/M13 identities as different architecture semantics." ;
