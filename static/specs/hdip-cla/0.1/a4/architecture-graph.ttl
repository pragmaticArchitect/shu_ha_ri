    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FRESTRICT_REALIZATION a a4:VocabularyTerm ;
    rdfs:comment "Constrain permitted M14 patterns/localities/providers for the bounded Profile." ;
    skos:prefLabel "RESTRICT_REALIZATION" ;
    a4:disposition "PERMITTED" ;
    a4:identifier "RESTRICT_REALIZATION" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FREWRITE_HISTORY a a4:VocabularyTerm ;
    rdfs:comment "Project latest Profile/policy/topology state backwards onto earlier occurrences." ;
    skos:prefLabel "REWRITE_HISTORY" ;
    a4:disposition "PROHIBITED" ;
    a4:identifier "REWRITE_HISTORY" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FSELECT a a4:VocabularyTerm ;
    rdfs:comment "Select an applicable baseline option or pattern." ;
    skos:prefLabel "SELECT" ;
    a4:disposition "PERMITTED" ;
    a4:identifier "SELECT" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FSPECIALIZE a a4:VocabularyTerm ;
    rdfs:comment "Introduce a family/domain specialization consistent with the parent authority." ;
    skos:prefLabel "SPECIALIZE" ;
    a4:disposition "PERMITTED" ;
    a4:identifier "SPECIALIZE" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FTIGHTEN a a4:VocabularyTerm ;
    rdfs:comment "Strengthen a threshold, control, evidence or lifecycle obligation." ;
    skos:prefLabel "TIGHTEN" ;
    a4:disposition "PERMITTED" ;
    a4:identifier "TIGHTEN" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FTRANSFER_AUTHORITY a a4:VocabularyTerm ;
    rdfs:comment "Infer Data, Product, policy or Decision authority from platform participation." ;
    skos:prefLabel "TRANSFER_AUTHORITY" ;
    a4:disposition "PROHIBITED" ;
    a4:identifier "TRANSFER_AUTHORITY" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FUNIVERSALIZE_SPECIALIZATION a a4:VocabularyTerm ;
    rdfs:comment "Impose a Data-, Information- or Intelligence-specific lifecycle/construct on all families without authority/evidence." ;
