    a4:identifier "STRUCTURAL" ;
    a4:vocabularyGroup "assessmentModes" .

vocab:claimTypes%2FCORE_ARCHITECTURE_CONFORMANCE a a4:VocabularyTerm ;
    rdfs:comment "The subject preserves all applicable M16 core invariants and the applicable responsibilities/contracts of the HDIP-CLA 0.1 baseline." ;
    skos:prefLabel "Core Architecture Conformance" ;
    a4:identifier "CORE_ARCHITECTURE_CONFORMANCE" ;
    a4:vocabularyGroup "claimTypes" .

vocab:claimTypes%2FPROFILE_CONFORMANCE a a4:VocabularyTerm ;
    rdfs:comment "The subject is Core-conformant and satisfies a named, governed, M16-valid HDIP Profile." ;
    skos:prefLabel "Profile Conformance" ;
    a4:identifier "PROFILE_CONFORMANCE" ;
    a4:vocabularyGroup "claimTypes" .

vocab:claimTypes%2FREALIZATION_MAPPING_CONFORMANCE a a4:VocabularyTerm ;
    rdfs:comment "A concrete implementation mapping faithfully realizes the claimed Core/Profile architecture, including traceability to Realization Units, M12 contracts, M13 boundaries/EBCs, evidence responsibilities, currentness and failure/recovery obligations." ;
    skos:prefLabel "Realization Mapping Conformance" ;
    a4:identifier "REALIZATION_MAPPING_CONFORMANCE" ;
    a4:vocabularyGroup "claimTypes" .

