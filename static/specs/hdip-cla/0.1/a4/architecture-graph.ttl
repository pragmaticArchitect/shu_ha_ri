    skos:prefLabel "CONTEXTUALIZE" ;
    a4:disposition "PERMITTED" ;
    a4:identifier "CONTEXTUALIZE" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FEXTEND a a4:VocabularyTerm ;
    rdfs:comment "Add local obligations/fields/controls that do not conflict with core meaning." ;
    skos:prefLabel "EXTEND" ;
    a4:disposition "PERMITTED" ;
    a4:identifier "EXTEND" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FINFER_PRODUCTNESS a a4:VocabularyTerm ;
