    skos:prefLabel "Governed HDIP Profile" ;
    a4:identifier "CS3" ;
    a4:vocabularyGroup "conformanceSubjectClasses" .

vocab:conformanceSubjectClasses%2FCS4 a a4:VocabularyTerm ;
