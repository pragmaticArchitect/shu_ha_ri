    a4:identifier "REDEFINE_CANONICAL_STRUCTURE" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FREDEFINE_EXTERNAL_SEMANTICS a a4:VocabularyTerm ;
