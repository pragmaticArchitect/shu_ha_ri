    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FREMOVE_APPLICABLE_OVERLAY a a4:VocabularyTerm ;
    rdfs:comment "Suppress an applicable X1-X9 obligation because implementation is inconvenient." ;
    skos:prefLabel "REMOVE_APPLICABLE_OVERLAY" ;
    a4:disposition "PROHIBITED" ;
    a4:identifier "REMOVE_APPLICABLE_OVERLAY" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FREMOVE_EVIDENCE_OBLIGATION a a4:VocabularyTerm ;
    rdfs:comment "Eliminate material evidence/currentness/history requirements needed by the parent baseline." ;
