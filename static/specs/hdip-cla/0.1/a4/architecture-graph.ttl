    skos:prefLabel "Enterprise HDIP Architecture" ;
    a4:identifier "CS1" ;
    a4:vocabularyGroup "conformanceSubjectClasses" .

vocab:conformanceSubjectClasses%2FCS2 a a4:VocabularyTerm ;
    rdfs:comment "A Data, Information, Intelligence or cross-domain bounded architecture." ;
    skos:prefLabel "Domain / Portfolio HDIP Architecture" ;
    a4:identifier "CS2" ;
    a4:vocabularyGroup "conformanceSubjectClasses" .

vocab:conformanceSubjectClasses%2FCS3 a a4:VocabularyTerm ;
