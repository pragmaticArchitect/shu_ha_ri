    a4:identifier "COLLAPSE_PRODUCT_FAMILIES" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FCONFLATE_REGISTRY_CATALOG_MARKETPLACE a a4:VocabularyTerm ;
