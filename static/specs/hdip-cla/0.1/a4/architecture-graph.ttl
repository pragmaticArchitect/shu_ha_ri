    skos:prefLabel "Platform / Solution Architecture" ;
    a4:identifier "CS4" ;
    a4:vocabularyGroup "conformanceSubjectClasses" .

vocab:conformanceSubjectClasses%2FCS5 a a4:VocabularyTerm ;
