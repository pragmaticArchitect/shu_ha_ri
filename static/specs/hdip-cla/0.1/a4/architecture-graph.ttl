    skos:prefLabel "INFER_PRODUCTNESS" ;
    a4:disposition "PROHIBITED" ;
    a4:identifier "INFER_PRODUCTNESS" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FN%2FA_BY_CONVENIENCE a a4:VocabularyTerm ;
