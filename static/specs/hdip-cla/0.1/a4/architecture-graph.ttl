    skos:prefLabel "Concrete Realization Mapping" ;
    a4:identifier "CS6" ;
    a4:vocabularyGroup "conformanceSubjectClasses" .

vocab:invariantResults%2FINDETERMINATE a a4:VocabularyTerm ;
    rdfs:comment "Available evidence cannot establish satisfaction or violation with the confidence required by the invariant." ;
    skos:prefLabel "INDETERMINATE" ;
    a4:identifier "INDETERMINATE" ;
    a4:vocabularyGroup "invariantResults" .

vocab:invariantResults%2FNOT_APPLICABLE a a4:VocabularyTerm ;
    rdfs:comment "The invariant condition genuinely does not arise in the bounded scope and the rationale is justified." ;
    skos:prefLabel "NOT_APPLICABLE" ;
    a4:identifier "NOT_APPLICABLE" ;
    a4:vocabularyGroup "invariantResults" .

vocab:invariantResults%2FSATISFIED a a4:VocabularyTerm ;
    rdfs:comment "The applicable invariant has sufficient evidence to establish satisfaction." ;
    skos:prefLabel "SATISFIED" ;
    a4:identifier "SATISFIED" ;
    a4:vocabularyGroup "invariantResults" .

vocab:invariantResults%2FVIOLATED a a4:VocabularyTerm ;
    rdfs:comment "The applicable invariant is demonstrably violated." ;
    skos:prefLabel "VIOLATED" ;
    a4:identifier "VIOLATED" ;
    a4:vocabularyGroup "invariantResults" .

vocab:overallOutcomes%2FCONFORMANT a a4:VocabularyTerm ;
    rdfs:comment "Every applicable core invariant is SATISFIED; N/A results have justified scope rationale; all obligations required by the claim type are satisfied." ;
    skos:prefLabel "CONFORMANT" ;
    a4:identifier "CONFORMANT" ;
    a4:vocabularyGroup "overallOutcomes" .

vocab:overallOutcomes%2FINDETERMINATE a a4:VocabularyTerm ;
    rdfs:comment "No applicable core invariant is known to be violated, but one or more material applicable obligations cannot be determined with sufficient evidence." ;
    skos:prefLabel "INDETERMINATE" ;
    a4:identifier "INDETERMINATE" ;
    a4:vocabularyGroup "overallOutcomes" .

vocab:overallOutcomes%2FNONCONFORMANT a a4:VocabularyTerm ;
    rdfs:comment "At least one applicable core invariant is VIOLATED, or a mandatory claim-type obligation is demonstrably violated." ;
    skos:prefLabel "NONCONFORMANT" ;
    a4:identifier "NONCONFORMANT" ;
    a4:vocabularyGroup "overallOutcomes" .

vocab:profileOperations%2FADD_EVIDENCE a a4:VocabularyTerm ;
    rdfs:comment "Require stronger/additional evidence, assurance or human review." ;
    skos:prefLabel "ADD_EVIDENCE" ;
    a4:disposition "PERMITTED" ;
    a4:identifier "ADD_EVIDENCE" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FCOLLAPSE_PRODUCT_FAMILIES a a4:VocabularyTerm ;
