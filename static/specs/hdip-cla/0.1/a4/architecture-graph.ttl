    a4:disposition "PROHIBITED" ;
    a4:identifier "CONFLATE_REGISTRY_CATALOG_MARKETPLACE" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FCONTEXTUALIZE a a4:VocabularyTerm ;
