element:M16-I01 a a4:Invariant ;
    rdfs:comment "HDIP-CLA SHALL NOT incompatibly redefine concepts, relationships or invariants owned by GEDRM, GEARM, GEAIRM or other applicable semantic authorities." ;
    skos:prefLabel "Semantic authority preservation" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "HDIP-CLA SHALL NOT incompatibly redefine concepts, relationships or invariants owned by GEDRM, GEARM, GEAIRM or other applicable semantic authorities." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "1" ;
    a4:identifier "M16-I01" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I01 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I01 .

element:M16-I02 a a4:Invariant ;
    rdfs:comment "Generic Product identity, Product Intrinsic Nature and Product qualification SHALL remain governed by BPS/PIN rather than inferred by HDIP." ;
    skos:prefLabel "Product authority preservation" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "Generic Product identity, Product Intrinsic Nature and Product qualification SHALL remain governed by BPS/PIN rather than inferred by HDIP." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "1" ;
    a4:identifier "M16-I02" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I02 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I02 .

element:M16-I03 a a4:Invariant ;
    rdfs:comment "Data Product, Information Product, AI Product and other Product-family qualification/classification SHALL remain with the applicable Product-family authority." ;
    skos:prefLabel "Product-family authority preservation" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "Data Product, Information Product, AI Product and other Product-family qualification/classification SHALL remain with the applicable Product-family authority." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "1" ;
    a4:identifier "M16-I03" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I03 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I03 .

element:M16-I04 a a4:Invariant ;
    rdfs:comment "Authority used by HDIP SHALL be explicit for an applicable scope, role, purpose, lifecycle state and/or jurisdiction where those distinctions matter; platform participation SHALL NOT imply universal authority." ;
    skos:prefLabel "Scoped authority" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "Authority used by HDIP SHALL be explicit for an applicable scope, role, purpose, lifecycle state and/or jurisdiction where those distinctions matter; platform participation SHALL NOT imply universal authority." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "1" ;
    a4:identifier "M16-I04" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I04 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I04 .

element:M16-I05 a a4:Invariant ;
    rdfs:comment "Co-location, shared storage, shared runtime, shared registry, shared UI or shared platform realization SHALL NOT by itself transfer semantic, Product, policy, decision or ownership authority." ;
    skos:prefLabel "Shared-realization non-transfer" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "Co-location, shared storage, shared runtime, shared registry, shared UI or shared platform realization SHALL NOT by itself transfer semantic, Product, policy, decision or ownership authority." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "1" ;
    a4:identifier "M16-I05" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I05 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I05 .

element:M16-I06 a a4:Invariant ;
    rdfs:comment "Where HDIP needs a semantic concept not owned by HDIP, the gap SHALL be referred to or extended through the appropriate semantic authority rather than silently minted as platform semantics." ;
    skos:prefLabel "Semantic-gap escalation" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "Where HDIP needs a semantic concept not owned by HDIP, the gap SHALL be referred to or extended through the appropriate semantic authority rather than silently minted as platform semantics." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "1" ;
    a4:identifier "M16-I06" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I06 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I06 .

element:M16-I07 a a4:Invariant ;
    rdfs:comment "Authority, approval, entitlement, policy applicability or ownership SHALL NOT become automatically transitive merely because a dependency, composition or interaction crosses an HDIP boundary." ;
    skos:prefLabel "Authority non-transitivity" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "Authority, approval, entitlement, policy applicability or ownership SHALL NOT become automatically transitive merely because a dependency, composition or interaction crosses an HDIP boundary." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "1" ;
    a4:identifier "M16-I07" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I07 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I07 .

element:M16-I08 a a4:Invariant ;
    rdfs:comment "A canonical HDIP ABB or mandatory implementation responsibility SHALL be justified by explicit architectural responsibility; a noun, tool, service label or historical box alone is insufficient." ;
    skos:prefLabel "Responsibility before component" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "A canonical HDIP ABB or mandatory implementation responsibility SHALL be justified by explicit architectural responsibility; a noun, tool, service label or historical box alone is insufficient." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "2" ;
    a4:identifier "M16-I08" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I08 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I08 .

element:M16-I09 a a4:Invariant ;
    rdfs:comment "A future HDIP Plane SHALL represent a coherent logical responsibility grouping and SHALL NOT imply a mandatory system, deployment unit, network tier, team, organizational boundary or lifecycle step." ;
    skos:prefLabel "Logical plane semantics" ;
    a4:assessmentMode "STRUCTURAL" ;
    a4:automationBoundary "STRUCTURAL_CHECKS_MAY_BE_DECISIVE_ONLY_WHERE_THE_FORMALIZED_EVIDENCE_FULLY_COVERS_THE_INVARIANT_CONDITION" ;
    a4:canonicalCondition "A future HDIP Plane SHALL represent a coherent logical responsibility grouping and SHALL NOT imply a mandatory system, deployment unit, network tier, team, organizational boundary or lifecycle step." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "2" ;
    a4:identifier "M16-I09" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I09 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I09 .

element:M16-I10 a a4:Invariant ;
    rdfs:comment "HDIP-CLA conformance SHALL NOT depend on centralized, federated, distributed, edge, embedded, provider-managed or hybrid deployment topology unless a narrower Profile explicitly requires it." ;
    skos:prefLabel "Topology independence" ;
    a4:assessmentMode "ASSESSMENT" ;
    a4:automationBoundary "ACCOUNTABLE_JUDGEMENT_PRIMARY_MACHINE_SUPPORT_ONLY" ;
    a4:canonicalCondition "HDIP-CLA conformance SHALL NOT depend on centralized, federated, distributed, edge, embedded, provider-managed or hybrid deployment topology unless a narrower Profile explicitly requires it." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "2" ;
    a4:identifier "M16-I10" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I10 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I10 .

element:M16-I11 a a4:Invariant ;
    rdfs:comment "One implementation MAY realize responsibilities from several HDIP logical structures, and one HDIP responsibility MAY be distributed across several implementations." ;
    skos:prefLabel "Many-to-many realization" ;
    a4:assessmentMode "STRUCTURAL" ;
    a4:automationBoundary "STRUCTURAL_CHECKS_MAY_BE_DECISIVE_ONLY_WHERE_THE_FORMALIZED_EVIDENCE_FULLY_COVERS_THE_INVARIANT_CONDITION" ;
    a4:canonicalCondition "One implementation MAY realize responsibilities from several HDIP logical structures, and one HDIP responsibility MAY be distributed across several implementations." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "2" ;
    a4:identifier "M16-I11" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I11 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I11 .

element:M16-I12 a a4:Invariant ;
    rdfs:comment "GEDRA, GEARA and GEAIRA plane numbering, placement or lexical similarity SHALL NOT force one-to-one HDIP plane mapping." ;
    skos:prefLabel "Source-plane non-equivalence" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "GEDRA, GEARA and GEAIRA plane numbering, placement or lexical similarity SHALL NOT force one-to-one HDIP plane mapping." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "2" ;
    a4:identifier "M16-I12" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I12 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I12 .

element:M16-I13 a a4:Invariant ;
    rdfs:comment "A responsibility that is cross-cutting in an applicable source architecture SHALL NOT be silently localized into one future HDIP plane without explicit justification that preserves its cross-cutting obligations." ;
    skos:prefLabel "Cross-cutting visibility" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "A responsibility that is cross-cutting in an applicable source architecture SHALL NOT be silently localized into one future HDIP plane without explicit justification that preserves its cross-cutting obligations." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "2" ;
    a4:identifier "M16-I13" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I13 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I13 .

element:M16-I14 a a4:Invariant ;
    rdfs:comment "Compute, storage, networking, messaging, identity infrastructure, orchestration and other utility capabilities SHALL NOT acquire semantic, Product, governance or domain authority merely because they enable those responsibilities." ;
    skos:prefLabel "Foundation separation" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "Compute, storage, networking, messaging, identity infrastructure, orchestration and other utility capabilities SHALL NOT acquire semantic, Product, governance or domain authority merely because they enable those responsibilities." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "2" ;
    a4:identifier "M16-I14" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I14 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I14 .

element:M16-I15 a a4:Invariant ;
    rdfs:comment "Every future canonical HDIP Plane, Overlay, ABB and material interaction SHALL trace to upstream responsibilities, explicit enterprise platform requirements and/or justified HDIP-specific coordination responsibilities." ;
    skos:prefLabel "Architecture traceability" ;
    a4:assessmentMode "STRUCTURAL" ;
    a4:automationBoundary "STRUCTURAL_CHECKS_MAY_BE_DECISIVE_ONLY_WHERE_THE_FORMALIZED_EVIDENCE_FULLY_COVERS_THE_INVARIANT_CONDITION" ;
    a4:canonicalCondition "Every future canonical HDIP Plane, Overlay, ABB and material interaction SHALL trace to upstream responsibilities, explicit enterprise platform requirements and/or justified HDIP-specific coordination responsibilities." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "2" ;
    a4:identifier "M16-I15" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I15 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I15 .

element:M16-I16 a a4:Invariant ;
    rdfs:comment "Data, Information and Intelligence SHALL remain distinguishable architectural/semantic concerns even where one platform capability co-realizes responsibilities from more than one domain." ;
    skos:prefLabel "Domain distinction" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "Data, Information and Intelligence SHALL remain distinguishable architectural/semantic concerns even where one platform capability co-realizes responsibilities from more than one domain." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "3" ;
    a4:identifier "M16-I16" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I16 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I16 .

element:M16-I17 a a4:Invariant ;
    rdfs:comment "A Data-specific, Information-specific or Intelligence-specific construct SHALL NOT automatically generalize to the other domains through shared implementation or naming similarity." ;
    skos:prefLabel "No cross-domain inheritance" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "A Data-specific, Information-specific or Intelligence-specific construct SHALL NOT automatically generalize to the other domains through shared implementation or naming similarity." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "3" ;
    a4:identifier "M16-I17" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I17 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I17 .

element:M16-I18 a a4:Invariant ;
    rdfs:comment "Composition, generation, transformation, persistence, deployment, publication, registration, cataloguing, marketplace presence, API exposure, repeated use or consumption SHALL NOT by itself establish Product identity." ;
    skos:prefLabel "No automatic Productness" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "Composition, generation, transformation, persistence, deployment, publication, registration, cataloguing, marketplace presence, API exposure, repeated use or consumption SHALL NOT by itself establish Product identity." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "3" ;
    a4:identifier "M16-I18" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I18 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I18 .

element:M16-I19 a a4:Invariant ;
    rdfs:comment "Co-realization of Data Products, Information Products and AI Products SHALL NOT collapse them into one HDIP-local Product family or type." ;
    skos:prefLabel "Product-family distinction" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "Co-realization of Data Products, Information Products and AI Products SHALL NOT collapse them into one HDIP-local Product family or type." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "3" ;
    a4:identifier "M16-I19" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I19 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I19 .

element:M16-I20 a a4:Invariant ;
    rdfs:comment "Using, depending on, containing, deriving from or invoking a Product/capability SHALL NOT by itself transfer its Product family, ontology type, ownership or authority to the dependent/composed result." ;
    skos:prefLabel "Composition non-inheritance" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "Using, depending on, containing, deriving from or invoking a Product/capability SHALL NOT by itself transfer its Product family, ontology type, ownership or authority to the dependent/composed result." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "3" ;
    a4:identifier "M16-I20" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I20 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I20 .

element:M16-I21 a a4:Invariant ;
    rdfs:comment "HDIP SHALL be able to support governed Data, Information or Intelligence capability use where Product qualification is not intended; Productization SHALL NOT be a mandatory gateway for every governed interaction." ;
    skos:prefLabel "Direct capability validity" ;
    a4:assessmentMode "ASSESSMENT" ;
    a4:automationBoundary "ACCOUNTABLE_JUDGEMENT_PRIMARY_MACHINE_SUPPORT_ONLY" ;
    a4:canonicalCondition "HDIP SHALL be able to support governed Data, Information or Intelligence capability use where Product qualification is not intended; Productization SHALL NOT be a mandatory gateway for every governed interaction." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "3" ;
    a4:identifier "M16-I21" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I21 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I21 .

element:M16-I22 a a4:Invariant ;
    rdfs:comment "Self-service SHALL operate inside applicable authority, policy, security, privacy, quality, evidence and lifecycle constraints; self-service SHALL NOT mean unrestricted infrastructure or data access." ;
    skos:prefLabel "Governed self-service" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "Self-service SHALL operate inside applicable authority, policy, security, privacy, quality, evidence and lifecycle constraints; self-service SHALL NOT mean unrestricted infrastructure or data access." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "4" ;
    a4:identifier "M16-I22" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I22 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I22 .

element:M16-I23 a a4:Invariant ;
    rdfs:comment "Participant-declared intent, business semantics and accountable judgement SHALL remain distinguishable from platform resolution, compilation, provisioning and automation." ;
    skos:prefLabel "Intent/compilation separation" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "Participant-declared intent, business semantics and accountable judgement SHALL remain distinguishable from platform resolution, compilation, provisioning and automation." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "4" ;
    a4:identifier "M16-I23" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I23 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I23 .

element:M16-I24 a a4:Invariant ;
    rdfs:comment "HDIP automation SHALL NOT transfer Product ownership, Data authority, policy authority or decision accountability to the compiler/runtime merely because the platform performs most technical work." ;
    skos:prefLabel "Automation non-ownership" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "HDIP automation SHALL NOT transfer Product ownership, Data authority, policy authority or decision accountability to the compiler/runtime merely because the platform performs most technical work." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "4" ;
    a4:identifier "M16-I24" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I24 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I24 .

element:M16-I25 a a4:Invariant ;
    rdfs:comment "Architecture/governance decisions requiring contextual or accountable judgement SHALL NOT be represented as machine-proven solely because metadata, telemetry, rules or model outputs exist." ;
    skos:prefLabel "Judgement honesty" ;
    a4:assessmentMode "ASSESSMENT" ;
    a4:automationBoundary "ACCOUNTABLE_JUDGEMENT_PRIMARY_MACHINE_SUPPORT_ONLY" ;
    a4:canonicalCondition "Architecture/governance decisions requiring contextual or accountable judgement SHALL NOT be represented as machine-proven solely because metadata, telemetry, rules or model outputs exist." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "4" ;
    a4:identifier "M16-I25" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I25 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I25 .

element:M16-I30 a a4:Invariant ;
    rdfs:comment "HDIP resolution/compilation SHALL NOT manufacture semantic relationships, Product identity, policy authority, joinability, provenance, dependencies or obligations from weak evidence or naming similarity." ;
    skos:prefLabel "Compiler non-invention" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "HDIP resolution/compilation SHALL NOT manufacture semantic relationships, Product identity, policy authority, joinability, provenance, dependencies or obligations from weak evidence or naming similarity." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "5" ;
    a4:identifier "M16-I30" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I30 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I30 .

element:M16-I32 a a4:Invariant ;
    rdfs:comment "Registration SHALL NOT by itself prove authoritative status, Product status, control effectiveness, semantic correctness, fitness or HDIP conformance." ;
    skos:prefLabel "Registry non-qualification" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "Registration SHALL NOT by itself prove authoritative status, Product status, control effectiveness, semantic correctness, fitness or HDIP conformance." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "5" ;
    a4:identifier "M16-I32" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I32 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I32 .

element:M16-I34 a a4:Invariant ;
    rdfs:comment "HDIP MAY consolidate registry implementation where operationally useful provided logical identities, ownership, contracts, lifecycle and authority boundaries remain distinguishable." ;
    skos:prefLabel "Shared registry realization allowed" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "HDIP MAY consolidate registry implementation where operationally useful provided logical identities, ownership, contracts, lifecycle and authority boundaries remain distinguishable." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "5" ;
    a4:identifier "M16-I34" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I34 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I34 .

element:M16-I35 a a4:Invariant ;
    rdfs:comment "Material HDIP interactions SHOULD emit or retain applicable provenance, control, quality, observability and lifecycle evidence sufficient for later reconstruction and assessment." ;
    skos:prefLabel "Evidence by construction" ;
    a4:assessmentMode "HYBRID" ;
    a4:automationBoundary "MACHINE_ASSISTED_ACCOUNTABLE_REVIEW_REQUIRED_FOR_FINAL_SATISFACTION" ;
    a4:canonicalCondition "Material HDIP interactions SHOULD emit or retain applicable provenance, control, quality, observability and lifecycle evidence sufficient for later reconstruction and assessment." ;
    a4:canonicality "FROZEN_SOURCE_ID" ;
    a4:elementKind "ARCHITECTURE_INVARIANT" ;
    a4:familyNumber "6" ;
    a4:identifier "M16-I35" ;
    a4:sourceDocument "docs/architecture/cla/hdip-cla-0.1-m16-architecture-invariants-conformance-model.md" ;
    a4:sourceInvariant derivation:M04-I35 ;
    hdiprel:PRESERVES_SOURCE_INVARIANT derivation:M04-I35 .

element:M16-I36 a a4:Invariant ;
    rdfs:comment "Platform location, certification label, popularity, centralization, Product status or registry presence SHALL NOT be treated as universal proof of trust or fitness; trust assessment SHALL remain contextual and evidence-based." ;
    skos:prefLabel "Trust is contextual" ;
    a4:assessmentMode "ASSESSMENT" ;
