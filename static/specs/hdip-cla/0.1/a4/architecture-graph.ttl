vocab:applicabilityStates%2FAPPLICABLE a a4:VocabularyTerm ;
    rdfs:comment "The invariant architectural condition materially arises within the assessed subject/scope." ;
    skos:prefLabel "APPLICABLE" ;
    a4:identifier "APPLICABLE" ;
    a4:vocabularyGroup "applicabilityStates" .

vocab:applicabilityStates%2FNOT_APPLICABLE a a4:VocabularyTerm ;
    rdfs:comment "The condition genuinely does not arise in the bounded scope and that conclusion is justified." ;
    skos:prefLabel "NOT_APPLICABLE" ;
    a4:identifier "NOT_APPLICABLE" ;
    a4:vocabularyGroup "applicabilityStates" .

vocab:applicabilityStates%2FUNDETERMINED a a4:VocabularyTerm ;
    rdfs:comment "During assessment, applicability itself cannot yet be established." ;
    skos:prefLabel "UNDETERMINED" ;
    a4:identifier "UNDETERMINED" ;
    a4:vocabularyGroup "applicabilityStates" .

vocab:assessmentModes%2FASSESSMENT a a4:VocabularyTerm ;
    rdfs:comment "Accountable judgement is primary; machine checks can support but cannot safely determine the conclusion by themselves." ;
    skos:prefLabel "ASSESSMENT" ;
    a4:identifier "ASSESSMENT" ;
    a4:vocabularyGroup "assessmentModes" .

vocab:assessmentModes%2FHYBRID a a4:VocabularyTerm ;
