    a4:disposition "PROHIBITED" ;
    a4:identifier "REMOVE_EVIDENCE_OBLIGATION" ;
    a4:vocabularyGroup "profileOperations" .

vocab:profileOperations%2FREQUIRE a a4:VocabularyTerm ;
    rdfs:comment "Make an optional/conditional baseline responsibility mandatory within Profile scope." ;
